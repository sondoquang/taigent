# Secrets / local env
.env
.env.*
!.env.example

# Personal agent config
.claude/settings.local.json
.codex/*
!.codex/config.toml
!.codex/rules/
!.codex/hooks/
.mcp.local.json

# Temporary state
.taigent/
tmp/
*.log

# BA preview working copies (taiga-apply-backlog carries the edits into backlog.yaml)
taiga/*/preview.md
taiga/*/.preview/

# Backlog snapshots of `taigent snapshot` (a local copy of Taiga, never committed)
taiga/*/snapshot.json

# Node
node_modules/

# Build output
dist/
