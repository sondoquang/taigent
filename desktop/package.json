{
  "name": "taigent-desktop",
  "productName": "Taigent Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Xem trước, góp ý và duyệt backlog Taiga (taiga/<slug>/backlog.yaml) trước khi đẩy lên Taiga.",
  "license": "MIT",
  "author": "Taigent",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "stage": "node scripts/stage-taigent.mjs",
    "dist": "npm run build && node scripts/stage-taigent.mjs && electron-builder --publish never",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "build": {
    "appId": "io.github.sondoquang.taigent-desktop",
    "productName": "Taigent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "package.json",
      "!node_modules/node-pty/{binding.gyp,deps,src,scripts,third_party,typings}{,/**}",
      "!node_modules/node-pty/**/*.{pdb,map,test.js}"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "stage/taigent/node_modules",
        "to": "taigent/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/node-pty/prebuilds/{darwin,linux}-*{,/**}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Taigent-Desktop-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "files": [
        "!node_modules/node-pty/prebuilds/{win32,linux}-*{,/**}"
      ]
    },
    "dmg": {
      "artifactName": "Taigent-Desktop-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
