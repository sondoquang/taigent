# Codex execpolicy rules (Starlark; https://learn.chatgpt.com/docs/agent-configuration/rules), loaded only when this
# project is trusted. Mirrors the taigent commands of tools/taiga/allowlist.txt (test/headless.test.ts checks that
# both list the same commands): they run outside the sandbox, with network, so plan/apply/bootstrap/upload/tickets/
# projects/report/snapshot/adopt/pull/metrics/status/comment/due reach Taiga. apply/bootstrap/upload still need --yes,
# which the skills add only after the user's confirmation; status/comment/due edit one of the user's own tickets, named
# in the request; projects, report, snapshot, adopt, pull and metrics only read (snapshot writes
# taiga/<slug>/snapshot.json, adopt taiga/<slug>/backlog.yaml, pull taiga/<slug>/backlog.yaml and state.json).
prefix_rule(
    pattern = ["npx", "taigent", ["validate", "plan", "apply", "bootstrap", "upload", "tickets", "status", "comment", "due", "preview", "projects", "report", "snapshot", "adopt", "pull", "metrics"]],
    decision = "allow",
    justification = "taigent CLI commands of the standard allowlist (tools/taiga/allowlist.txt)",
    match = [
        "npx taigent validate --project vigo-auth",
        "npx taigent plan --project vigo-auth --json",
        "npx taigent apply --project vigo-auth --yes",
        "npx taigent bootstrap --project vigo-auth --dry-run",
        "npx taigent upload --project vigo-auth --yes",
        "npx taigent tickets --from 2026-10-26 --to 2026-11-01 --project vigo-auth --json",
        "npx taigent status --project vigo-auth 84 Done",
        "npx taigent comment --project vigo-auth 84 'tested on UAT'",
        "npx taigent due --project vigo-auth 84 2026-11-24 'shares its days with #85'",
        "npx taigent preview --project vigo-auth --json",
        "npx taigent projects --project vigo-auth --json",
        "npx taigent report --project vigo-auth --json",
        "npx taigent snapshot --project vigo-auth --json",
        "npx taigent adopt --project vigo-auth --ref 84 --key AUTH-LOGIN --json",
        "npx taigent pull --project vigo-auth --key AUTH-LOGIN --json",
        "npx taigent metrics --project vigo-auth --json",
    ],
    not_match = [
        "npx taigent skills check",
        "npx -y taigent plan --project vigo-auth",
        "npm test",
    ],
)

# review resolve answers a review comment in taiga/<slug>/review.yaml (taiga-plan-backlog); the other review
# subcommands (verdicts, new comments) are the reviewer's own and are never allowed.
prefix_rule(
    pattern = ["npx", "taigent", "review", "resolve"],
    decision = "allow",
    justification = "taigent review resolve of the standard allowlist (tools/taiga/allowlist.txt): answers a review comment",
    match = [
        "npx taigent review resolve --project vigo-auth AUTH-LOGIN c1 -- 'Đã thêm tiêu chí'",
    ],
    not_match = [
        "npx taigent review approve --project vigo-auth AUTH",
        "npx taigent review request-changes --project vigo-auth AUTH",
        "npx taigent review comment --project vigo-auth AUTH",
    ],
)
