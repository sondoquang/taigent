# Codex execpolicy rules (Starlark; https://learn.chatgpt.com/docs/agent-configuration/rules), loaded only when this
# project is trusted. Mirrors the taigent commands of tools/taiga/allowlist.txt (test/headless.test.ts checks that
# both list the same commands): they run outside the sandbox, with network, so plan/apply/bootstrap/upload/tickets/
# projects/report/status/comment reach Taiga. apply/bootstrap/upload still need --yes, which the skills add only after
# the user's confirmation; status/comment edit one of the user's own tickets, named in the request; projects and report
# only read.
prefix_rule(
    pattern = ["npx", "taigent", ["validate", "plan", "apply", "bootstrap", "upload", "tickets", "status", "comment", "preview", "projects", "report"]],
    decision = "allow",
    justification = "taigent CLI commands of the standard allowlist (tools/taiga/allowlist.txt)",
    match = [
        "npx taigent validate --project vigo-auth",
        "npx taigent plan --project vigo-auth --json",
        "npx taigent apply --project vigo-auth --yes",
        "npx taigent bootstrap --project vigo-auth --dry-run",
        "npx taigent upload --project vigo-auth --yes",
        "npx taigent tickets --from 2026-10-26 --to 2026-11-01 --project vigo-auth --json",
        "npx taigent status --project vigo-auth 84 Done",
        "npx taigent comment --project vigo-auth 84 'tested on UAT'",
        "npx taigent preview --project vigo-auth --json",
        "npx taigent projects --project vigo-auth --json",
        "npx taigent report --project vigo-auth --json",
    ],
    not_match = [
        "npx taigent skills check",
        "npx -y taigent plan --project vigo-auth",
        "npm test",
    ],
)
