{
  "name": "taigent",
  "version": "0.1.0",
  "description": "Headless CLI that applies declarative Taiga manifests (plan -> review -> apply).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sondoquang/taigent.git"
  },
  "type": "module",
  "bin": {
    "taigent": "bin/taigent.js"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/cli.md",
    "docs/taiga/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "taigent": "node bin/taigent.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:live": "node --test \"test/live/*.live.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "taiga-mcp-server": "1.9.20",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
