{
  "name": "taigent",
  "version": "0.1.0",
  "private": true,
  "description": "Headless CLI that applies declarative Taiga manifests (plan -> review -> apply).",
  "type": "module",
  "bin": {
    "taigent": "bin/taigent.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "taigent": "node bin/taigent.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:live": "node --test \"test/live/*.live.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
