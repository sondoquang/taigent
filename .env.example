# Not needed on a machine where you ran `npx taigent login` (it stores a token in the OS credential store).
# For CI or machines without one: copy to .env (git-ignored) or set these in the environment. Never commit real values.
# They override the stored login, for the taigent CLI and for the Taiga MCP server it runs (`taigent mcp`).
# Taiga API base, e.g. https://taiga.example.com/api/v1
TAIGA_API_URL=
TAIGA_USERNAME=
TAIGA_PASSWORD=
# Optional: access token used instead of username/password
TAIGA_TOKEN=
# Optional, `taigent notify`: by default it uses the bot and the paired chat of the Claude Code Telegram plugin
# (/telegram:configure, /telegram:access pair). Set these to use another bot or chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
