# Copy to .env (git-ignored; read by the taigent CLI) or set these in your personal environment. Never commit real values.
# The Taiga MCP server does not read .env: register it with the taiga-setup skill.
# Taiga API base, e.g. https://taiga.example.com/api/v1
TAIGA_API_URL=
TAIGA_USERNAME=
TAIGA_PASSWORD=
# Optional: access token the taigent CLI uses instead of username/password (the MCP server still needs them)
TAIGA_TOKEN=
